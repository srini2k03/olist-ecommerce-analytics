# Copy to .env (never commit .env). Everything is optional: the defaults work locally.

# Where the raw CSVs and the DuckDB warehouse live (defaults: data/, data/raw, data/olist.duckdb)
# OLIST_DATA_DIR=data
# OLIST_RAW_DIR=data/raw
# OLIST_DUCKDB=data/olist.duckdb

# Postgres portability check: `make postgres`, `make sql-compare`, CI's parity job
# OLIST_PG_DSN=postgresql://user:password@localhost:5432/olist
# OLIST_PG_TEST_DSN=postgresql://user:password@localhost:5432/olist_test   # may be overwritten

# Optional Kaggle download (otherwise the checksum-pinned public mirror is used)
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Logging level for the pipeline (key=value lines on stderr)
# OLIST_LOG_LEVEL=INFO

# Playwright smoke tests: use a system Chromium instead of the Playwright-managed one
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/google-chrome
